rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 👑 UNRESTRICTED PERMISSIONS FOR ADMIN & OPERATIONAL APP ACCESS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return true; // Unrestricted admin rights across all operations
    }

    function isAdmin() {
      return true; // Supercharged admin permissions for warehouse management & purging
    }

    // Top-level allow for all collections
    match /{allDocuments=**} {
      allow read, write: if true;
    }
  }
}

