rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    
    // Checks if the current user has verified administrator access
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'serghie.daniel@gmail.com' ||
          request.auth.token.email.lower() == 'daserghie@pick.app' ||
          request.auth.token.email.lower() == 'admin@pick.app'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users & Operator Profiles
    match /users/{userId} {
      allow read, write: if isSignedIn() || isAdmin();

      match /shifts/{shiftId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
    }

    // 2. Leaderboard & Summaries
    match /leaderboard/{entryId} {
      allow read, write: if isSignedIn() || isAdmin();
    }
    
    match /shift_summaries/{summaryId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // 3. Settings & Config
    match /warehouse_settings/{docId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isSignedIn() || isAdmin();
    }

    match /global_config/{docId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isSignedIn() || isAdmin();
    }

    // 4. Logs & Feedback
    match /beta_logs/{docId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    match /beta_feedback_logs {
      allow read, write: if isSignedIn() || isAdmin();
    }
    
    match /beta_feedback_logs/{docId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // 5. Warehouses
    match /warehouses/{warehouseId} {
      allow read, write: if isSignedIn() || isAdmin();
      
      match /leaderboard/{entryId} {
        allow read, write: if isSignedIn() || isAdmin();
      }

      match /live_users/{userId} {
        allow read, write: if isSignedIn() || isAdmin();
      }

      match /config {
        allow read, write: if isSignedIn() || isAdmin();
      }
      
      match /config/{docId} {
        allow read, write: if isSignedIn() || isAdmin();
      }

      match /shifts/{shiftId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
    }

    // 6. Interactions
    match /interactions/{interactionId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // 7. Shift Photos
    match /shift_photos/{photoId} {
      allow read, write: if isSignedIn() || isAdmin();
    }

    // Default fallback for authenticated and admin sessions
    match /{document=**} {
      allow read, write: if isSignedIn() || isAdmin();
    }
  }
}


